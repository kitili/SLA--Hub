{
  "name": "ops-system",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/write-ticketing-config.mjs && node -e \"const fs=require('fs'); ['.next/dev/cache/turbopack','.next/cache/turbopack'].forEach((p)=>fs.rmSync(p,{recursive:true,force:true}));\"",
    "dev": "next dev --port 3000",
    "prebuild": "node scripts/write-ticketing-config.mjs",
    "build": "next build",
    "start": "next start --port 3000",
    "lint": "eslint",
    "test:driver": "node --test scripts/test-driver-helpers.mjs",
    "test:scan": "node --test scripts/test-boarding-scan.mjs",
    "test:transport-kpis": "node --test scripts/test-transport-ceo-math.mjs",
    "test:route-direction": "node --test scripts/test-route-direction.mjs",
    "test:trip-run": "node --test scripts/test-trip-run.mjs",
    "test:edadmin": "node --test scripts/test-edadmin-parse.mjs",
    "provision:drivers": "node scripts/provision-drivers.mjs",
    "smoke:driver": "node scripts/smoke-driver-app.mjs",
    "smoke:ops-fixes": "node scripts/smoke-ops-fixes.mjs",
    "smoke:scan": "node scripts/smoke-scan-fixes.mjs",
    "smoke:ticketing": "node scripts/smoke-ticketing-transport.mjs",
    "smoke:app": "node scripts/smoke-app.mjs",
    "ticketing:config": "node scripts/write-ticketing-config.mjs",
    "mobile:sync": "npx cap sync android",
    "mobile:open": "npx cap open android",
    "mobile:apk": "bash scripts/build-driver-apk.sh",
    "mobile:apk:release": "bash scripts/build-driver-apk.sh release"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/cli": "^7.6.8",
    "@capacitor/core": "^8.5.0",
    "@capacitor/geolocation": "^8.2.0",
    "@capacitor/splash-screen": "^8.0.2",
    "@fontsource/bai-jamjuree": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.109.0",
    "html5-qrcode": "^2.3.8",
    "leaflet": "^1.9.4",
    "next": "16.2.12",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-qr-code": "^2.2.0",
    "server-only": "^0.0.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/google.maps": "^3.65.4",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
