# Supabase (create project at https://supabase.com — Kai owns this)
# Copy this file to .env.local and fill in real values. Never put secrets here.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# App (dev uses port 3001 — see package.json)
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Ticketing desk — same Supabase project as transport by default.
# scripts/write-ticketing-config.mjs falls back to NEXT_PUBLIC_SUPABASE_*.
# Optional override only if you ever split ticketing to another project:
# TICKETING_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# TICKETING_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Cron (Day 5) — Bearer token for /api/cron/sync-fees
CRON_SECRET=replace-with-long-random-string
# Optional — Bearer for /api/ticketing/notify (falls back to CRON_SECRET)
DESK_NOTIFY_SECRET=

# Messaging (Day 6) — Africa's Talking SMS. Leave blank to stub (logs only).
AFRICASTALKING_API_KEY=
AFRICASTALKING_USERNAME=
AFRICASTALKING_FROM=

# Optional: SMS admin on high-severity incidents (Week 2+)
ADMIN_ALERT_PHONE=

# Google Maps (Driver app trip map + Directions road line)
# Enable Maps JavaScript API + Directions API on the key.
# Browser key → NEXT_PUBLIC_*; server Directions can reuse or use a separate key.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_API_KEY=

# OpenRouteService (road-following route geometry — no billing account needed,
# tried before Google Directions in /api/routes/geometry). Free key from
# https://openrouteservice.org/dev/#/signup
ORS_API_KEY=

# Ed-admin Integration API (local only — never commit real keys)
# EDADMIN_BASE_URL=https://YOUR-SILVERLEAF-EDADMIN-HOST
# EDADMIN_GENERAL_API_KEY=
# EDADMIN_SASAMS_KEY=

# Staff provisioning (scripts/provision-staff.mjs) — never commit real passwords
# STAFF_SLT_PASSWORD=slt2026
# STAFF_ADMIN_PASSWORD=          # legacy alias for STAFF_SLT_PASSWORD / Baraka fallback
# STAFF_MATRON_PASSWORD=
# STAFF_BARAKA_PASSWORD=
# STAFF_SHIKUNZI_PASSWORD=
# STAFF_KUSADUKA_PASSWORD=
# STAFF_FINANCE_PASSWORD=
# STAFF_DRIVER_PASSWORD=
# STAFF_FARM_PASSWORD=
