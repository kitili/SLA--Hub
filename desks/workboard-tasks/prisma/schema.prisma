generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  STAFF
  MANAGER
  ADMIN
}

enum TaskStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  IN_REVIEW
  COMPLETED
  BLOCKED
  CANCELLED
}

enum TaskType {
  TASK
  STORY
  BUG
}

enum TaskPriority {
  LOWEST
  LOW
  MEDIUM
  HIGH
  HIGHEST
}

enum TaskSource {
  DAILY
  BACKLOG
  PROJECT
  MANUAL
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum ActivityType {
  CREATED
  STATUS_CHANGED
  UPDATED
  ASSIGNED
  COMMENT
  DAILY_SUBMITTED
  DAILY_COMPLETED
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users    User[]
  projects Project[]
  tasks    Task[]
  progressUpdates ProgressUpdate[]

  @@index([slug])
}

model User {
  id             String   @id @default(cuid())
  organizationId String
  phone          String   @unique
  email          String?  @unique
  username       String?  @unique
  name           String?
  jobTitle       String?
  bio            String?
  avatarUrl      String?
  role           UserRole @default(STAFF)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  dailyPlans   DailyPlan[]
  tasks        Task[]       @relation("TaskAssignee")
  authoredTasks Task[]    @relation("TaskAuthor")
  ownedMoves   Task[]     @relation("TaskMoveOwner")
  activities   TaskActivity[]
  messages     ChatMessage[]
  comments     TaskComment[]
  progressUpdates ProgressUpdate[]

  @@index([organizationId])
  @@index([phone])
}

enum DailyNoteKind {
  PROGRESS
  CHALLENGE
}

model ProgressUpdate {
  id             String        @id @default(cuid())
  organizationId String
  authorId       String
  body           String
  planDate       DateTime      @db.Date
  kind           DailyNoteKind @default(PROGRESS)
  readByIds      String[]      @default([])
  createdAt      DateTime      @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  author       User         @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([organizationId, kind, createdAt])
  @@index([authorId, createdAt])
}

model EmailOtp {
  id        String    @id @default(cuid())
  email     String
  codeHash  String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email])
  @@index([expiresAt])
  @@map("email_otps")
}

model Project {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  description    String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  key          String   @default("PRJ")
  taskCounter  Int      @default(0)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tasks        Task[]

  @@unique([organizationId, name])
  @@unique([organizationId, key])
  @@index([organizationId, isActive])
}

model DailyPlan {
  id        String   @id @default(cuid())
  userId    String
  planDate  DateTime @db.Date
  submittedAt DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  items DailyPlanItem[]

  @@unique([userId, planDate])
  @@index([planDate])
}

model DailyPlanItem {
  id          String     @id @default(cuid())
  dailyPlanId String
  slot        Int
  title       String
  status      TaskStatus @default(IN_PROGRESS)
  blockerNote String?
  taskId      String?    @unique
  completedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  dailyPlan DailyPlan @relation(fields: [dailyPlanId], references: [id], onDelete: Cascade)
  task      Task?     @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@unique([dailyPlanId, slot])
  @@index([status])
}

model Task {
  id             String       @id @default(cuid())
  organizationId String
  projectId      String?
  assigneeId     String?
  authorId       String?
  moveOwnerId    String?
  sharedWithIds  String[]     @default([])
  taskKey        String?      @unique
  title          String
  description    String?
  status         TaskStatus   @default(BACKLOG)
  type           TaskType     @default(TASK)
  source         TaskSource   @default(BACKLOG)
  priority       TaskPriority?
  labels         String[]     @default([])
  storyPoints    Int?
  columnOrder    Int          @default(0)
  dueDate        DateTime?
  blockerNote    String?
  completedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  assignee     User?         @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  author       User?         @relation("TaskAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  moveOwner    User?         @relation("TaskMoveOwner", fields: [moveOwnerId], references: [id], onDelete: SetNull)
  dailyItem    DailyPlanItem?
  activities   TaskActivity[]
  comments     TaskComment[]

  @@index([organizationId, status])
  @@index([assigneeId, status])
  @@index([projectId, status])
  @@index([projectId, status, columnOrder])
  @@index([createdAt])
}

model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  userId    String?
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([taskId, createdAt])
}

model TaskActivity {
  id        String       @id @default(cuid())
  taskId    String
  userId    String?
  type      ActivityType
  fromStatus TaskStatus?
  toStatus   TaskStatus?
  message   String?
  metadata  Json?
  createdAt DateTime     @default(now())

  task Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([taskId, createdAt])
  @@index([createdAt])
}

model ChatMessage {
  id              String           @id @default(cuid())
  userId          String?
  waMessageId     String?          @unique
  direction       MessageDirection
  phone           String
  body            String
  parsedCommand   String?
  processed       Boolean          @default(false)
  processingError String?
  rawPayload      Json?
  createdAt       DateTime         @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([phone, createdAt])
  @@index([userId, createdAt])
  @@index([processed, createdAt])
}

model WebhookEvent {
  id          String   @id @default(cuid())
  waMessageId String   @unique
  payload     Json
  processedAt DateTime @default(now())

  @@index([processedAt])
}
