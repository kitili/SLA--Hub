{
  "name": "silverleaf-onboarding-hub",
  "version": "1.0.0",
  "private": true,
  "description": "Silverleaf Academy Staff Onboarding Hub — Next.js (App Router) migration",
  "scripts": {
    "dev": "DATABASE_URL= npm run db:migrate && DATABASE_URL= next dev",
    "build": "next build",
    "vercel-build": "npm run db:migrate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --conditions=react-server --import ./src/lib/db/scripts/ts-resolve.mjs ./src/lib/db/scripts/migrate.ts",
    "db:seed": "tsx --conditions=react-server --import ./src/lib/db/scripts/ts-resolve.mjs ./src/lib/db/scripts/seed.ts",
    "db:reset": "rm -rf .pglite && DATABASE_URL= npm run db:migrate && DATABASE_URL= npm run db:seed",
    "hiring:import-csv": "tsx --conditions=react-server --import ./src/lib/db/scripts/ts-resolve.mjs ./src/lib/db/scripts/import-hiring-csv.ts",
    "db:studio": "drizzle-kit studio",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.3",
    "@fontsource/bai-jamjuree": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@react-pdf/renderer": "^4.5.1",
    "@vercel/blob": "^2.4.1",
    "docx-preview": "^0.4.0",
    "drizzle-orm": "^0.45.2",
    "googleapis": "^174.0.1",
    "mammoth": "^1.12.1",
    "next": "15.5.19",
    "next-intl": "^4.13.0",
    "nodemailer": "^9.0.3",
    "postgres": "^3.4.9",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "server-only": "^0.0.1",
    "unpdf": "^1.7.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "^1.61.0",
    "@types/node": "^20.19.0",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.4",
    "eslint-config-next": "15.5.19",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "@swc/helpers": "0.5.23",
    "postcss": "^8.5.10"
  },
  "engines": {
    "node": ">=20"
  }
}
