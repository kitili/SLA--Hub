# ---------------------------------------------------------------------------
# .env.production.example — reference for production environment variables
# ---------------------------------------------------------------------------
# On Vercel, production environment variables are managed in the Vercel
# dashboard (Project → Settings → Environment Variables) or via the CLI:
#
#   vercel env add DATABASE_URL production
#
# You do NOT deploy a .env.production file to Vercel. This file exists only
# as a reference so developers know which variables are expected in production.
#
# For local testing against a production-like config, run:
#   vercel env pull .env.local    (requires `vercel link` first)
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# DATABASE — auto-injected by Vercel Postgres (Neon). SERVER-ONLY.
# Never expose DATABASE_URL or DATABASE_PUBLIC_URL as NEXT_PUBLIC_*.
# DATABASE_URL is the owner connection (migrations). DATABASE_PUBLIC_URL is the
# optional least-privilege (RLS) key for request traffic.
# ---------------------------------------------------------------------------
DATABASE_URL=
DATABASE_PUBLIC_URL=

# ---------------------------------------------------------------------------
# ADMIN ACCESS — set manually in Vercel dashboard
# ---------------------------------------------------------------------------

# Comma-separated work emails granted /admin access. These do NOT bypass the
# ed-admin sign-in check — an admin email must also be an active ed-admin staff
# member to sign in.
HR_ADMIN_EMAILS=hr@silverleaf.co.tz

# Informational only — no longer the sign-in gate (ed-admin membership is).
ALLOWED_EMAIL_DOMAIN=silverleaf.co.tz

# Secret used to HMAC-sign the session cookie. REQUIRED — the app refuses to
# start in production without it. Min 32 chars; generate with `openssl rand
# -base64 48`. Rotating this value invalidates all existing sessions.
SESSION_SECRET=CHANGE_TO_A_RANDOM_32+_CHAR_SECRET

# AES-256-GCM key for bio PII. REQUIRED in production. 32+ chars.
DATA_ENCRYPTION_KEY=CHANGE_TO_A_RANDOM_32+_CHAR_SECRET

# Optional Cloudflare Turnstile for the public apply form.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---------------------------------------------------------------------------
# ED-ADMIN STAFF DIRECTORY — set manually in Vercel dashboard
# ---------------------------------------------------------------------------
# Bearer token for the ed-admin staff directory; required to verify staff
# sign-in (work email + Staff ID). Optional ED_ADMIN_STAFF_API_URL overrides
# the default endpoint baked into the code.
ED_ADMIN_API_TOKEN=
# ED_ADMIN_STAFF_API_URL=

# ---------------------------------------------------------------------------
# VERCEL BLOB — auto-injected after provisioning
# ---------------------------------------------------------------------------
# After adding Vercel Blob from the dashboard/marketplace, Vercel
# automatically injects BLOB_READ_WRITE_TOKEN into the project.
BLOB_READ_WRITE_TOKEN=

# Google Form → POST /api/hiring/applications (Bearer token).
APPLICATIONS_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# SMTP — REQUIRED for email OTP sign-in (and hiring / SLA-bot mail)
# ---------------------------------------------------------------------------
# Production will NOT silently stub OTP emails. Without these, sign-in codes
# fail with a clear error instead of a fake "code sent" success.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# ---------------------------------------------------------------------------
# POLICY BRIEFINGS / SLA-BOT — optional
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# ALERT_EMAIL=hr@silverleaf.co.tz
# HUB_FROM_NAME=Silverleaf Onboarding Hub
# HUB_FROM_EMAIL=noreply@silverleaf.co.tz
