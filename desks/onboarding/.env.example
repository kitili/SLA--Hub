# ---------------------------------------------------------------------------
# .env.example — local development defaults for Next.js on Vercel
# Copy to .env.local and fill in real values. NEVER commit .env.local.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# DATABASE
# ---------------------------------------------------------------------------

# SERVER-ONLY Postgres URL (never NEXT_PUBLIC_*). This is the private owner
# connection used for migrations. Local: leave empty for PGlite.
# Production: Vercel/Neon injects this.
DATABASE_URL=

# Least-privilege (RLS-bound) URL for request traffic — the public/anon analog.
# Never NEXT_PUBLIC_*. Leave empty to reuse DATABASE_URL. Only set this when
# the role is not the table owner and migration 0019 policies are applied.
DATABASE_PUBLIC_URL=

# ---------------------------------------------------------------------------
# APPLICATION
# ---------------------------------------------------------------------------

# Next.js sets NODE_ENV automatically; only override here if you need to
# simulate a specific environment locally.
# NODE_ENV=development

# ---------------------------------------------------------------------------
# ADMIN ACCESS
# ---------------------------------------------------------------------------

# Comma-separated work emails granted /admin access. NOTE: these do NOT bypass
# the ed-admin sign-in check — an admin email must ALSO be an active ed-admin
# staff member to sign in. Set by: developer (Vercel dashboard for preview/prod; .env.local for dev).
HR_ADMIN_EMAILS=krupa@silverleaf.co.tz,hr@silverleaf.co.tz

# Per-admin bootstrap passwords (email:password pairs). Optional fallback: ADMIN_PIN.
# Placeholders only — never commit real credentials.
ADMIN_PASSWORDS=admin@example.com:change-me
ADMIN_PIN=

# Local/dev only: allow password-verified admins missing from ed-admin to sign in.
# Do NOT set this on Vercel production.
# ADMIN_ALLOW_LOCAL_DIRECTORY_FALLBACK=1

# Informational only — no longer the sign-in gate (ed-admin membership is).
# Used for email normalisation/placeholders. Optional; defaults to silverleaf.co.tz.
ALLOWED_EMAIL_DOMAIN=silverleaf.co.tz

# ---------------------------------------------------------------------------
# SESSION
# ---------------------------------------------------------------------------

# Secret used to HMAC-sign the session cookie. REQUIRED in production (the auth
# provider refuses to start without it outside development). Min 32 chars; use a
# long random value, e.g. `openssl rand -base64 48`. Set by: developer.
SESSION_SECRET=<set-a-random-32+-char-secret>

# AES-256-GCM key for bio PII (IDs, bank, phones). 32+ chars. Production: required.
# Dev falls back to SESSION_SECRET. Generate with `openssl rand -base64 48`.
DATA_ENCRYPTION_KEY=

# Optional Cloudflare Turnstile for /api/hiring/apply. Site key is public
# (NEXT_PUBLIC_*). Secret is server-only. Leave both empty locally.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---------------------------------------------------------------------------
# ED-ADMIN STAFF DIRECTORY (sign-in verification)
# ---------------------------------------------------------------------------
# Staff sign in with their work email + ed-admin Staff ID, verified against the
# ed-admin staff directory. REQUIRED for non-admin sign-in. Set by: developer.
ED_ADMIN_API_TOKEN=
# Optional override; defaults in code to the Silverleaf endpoint.
# ED_ADMIN_STAFF_API_URL=https://silverleafacademy.ed-space.net/api/general/v1/staff

# ---------------------------------------------------------------------------
# VERCEL BLOB  [provisioned later — leave empty until Blob storage is added]
# ---------------------------------------------------------------------------

# Read/write token for Vercel Blob storage (file uploads).
# Auto-injected by Vercel after adding Blob from the dashboard/marketplace.
# Set by: Vercel-injected (do not set manually in production).
# Local dev: leave empty — hiring uploads use documents/hiring-uploads/ on disk.
BLOB_READ_WRITE_TOKEN=

# ---------------------------------------------------------------------------
# HR HIRING PIPELINE
# ---------------------------------------------------------------------------

# Public base URL for apply/upload links in candidate emails.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Default performance task document/link (required before NEXT · Performance).
DEFAULT_PERFORMANCE_TASK_LINK=

# Google Form → POST /api/hiring/applications (Bearer token).
APPLICATIONS_WEBHOOK_SECRET=

# Working-day deadlines referenced in pipeline emails.
CULTURE_DEADLINE_WORKING_DAYS=2
PERFORMANCE_DEADLINE_WORKING_DAYS=3

# Interview invitation copy (plain text or HTML snippet).
ONLINE_INTERVIEW_SCHEDULING_URL=
ONLINE_INTERVIEW_SCHEDULING_INFO=

# ---------------------------------------------------------------------------
# GOOGLE CALENDAR — online interview scheduling
# ---------------------------------------------------------------------------
# OAuth2 credentials from Google Console (Web Application type).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Refresh token obtained via the one-time /api/auth/google flow (logged in as jobs@silverleaf.co.tz).
GOOGLE_REFRESH_TOKEN=
# Calendar to create events on. Defaults to jobs@silverleaf.co.tz.
GOOGLE_CALENDAR_ID=jobs@silverleaf.co.tz
# HR email added as attendee on calendar events.
GOOGLE_IMPERSONATE_EMAIL=jobs@silverleaf.co.tz
IN_PERSON_INTERVIEW_LOCATION=
IN_PERSON_INTERVIEW_INFO=

# SMTP — leave unset locally to stub emails to the server console.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
HIRING_FROM_NAME=Silverleaf Academy HR
HIRING_FROM_EMAIL=jobs@silverleaf.co.tz
HIRING_REPLY_TO=jobs@silverleaf.co.tz

# ---------------------------------------------------------------------------
# NOTES ON INTENTIONALLY OMITTED VARS
# ---------------------------------------------------------------------------
# PORT          — Vercel manages the port; not configurable.
# CORS_ORIGIN   — Not applicable; Next.js API routes use middleware/headers.
# SERVE_CLIENT  — Not applicable; Next.js serves its own frontend.
# PG_SOCKET_DIR — Not applicable; Vercel Postgres uses a URL, not a socket.
# DEV_CLIENT_URL — Not applicable; removed with the Express/Vite split.
# DOCS_PATH     — Not applicable; static assets live in public/ or Blob.
# ALERT_EMAIL   — Optional extra recipient for SLA-bot feedback/alarms (defaults
#                 to hr@silverleaf.co.tz when HR_ADMIN_EMAILS is empty).
# OPENAI_API_KEY — Optional; improves SLA-bot and policy briefing answers.
# HUB_FROM_EMAIL / HUB_FROM_NAME — From address for SLA-bot alert emails.
#
# next-intl:    No secrets required; locale config lives in source files.
# Auth:         No secrets required yet; add NEXTAUTH_SECRET etc. when
#               authentication is introduced.
