# ---------------------------------------------------------------------------
# .env.example — Silverleaf Lesson Plans — local development reference
# Copy to .env.local and fill in real values. NEVER commit .env.local.
#
# Local dev needs NO env vars at all: with DATABASE_URL unset the app runs on
# embedded PGlite, and with OPENROUTER_API_KEY unset AI Studio simply shows as
# disabled. Set vars below only when you want the real services.
# See DEPLOYMENT.md for which of these Vercel auto-injects vs. you set manually.
# ---------------------------------------------------------------------------

# ===========================================================================
# DATABASE
# ===========================================================================

# Postgres connection string.
# Local dev: leave UNSET to use embedded PGlite (zero setup). Set it to point
#   at a real Postgres/Neon branch if you want to develop against Postgres.
# Preview/Production: auto-injected by Vercel Postgres (Neon) — do NOT set
#   manually in those environments.
# DATABASE_URL=postgresql://localhost:5432/silverleaf_dev

# Toggle Postgres trigram (pg_trgm) fuzzy search in lesson search.
# Postgres only (PGlite ignores it). Absent/empty → trigram disabled, plain
# search is used. Set to 1/true in preview/prod once pg_trgm is available.
# SEARCH_TRIGRAM=

# ===========================================================================
# AUTH  (sign-in, admin access, ed-admin staff directory)
# ===========================================================================

# Session signing secret for the auth cookie. Use a long random string in
# preview/prod (e.g. `openssl rand -hex 32`). Set by: developer.
SESSION_SECRET=change-me-dev-only-secret

# Auth provider implementation: "email" (default) or "inbound-trust" (stub).
# Leave unset unless the trusted-header provider is wired. Set by: developer.
# AUTH_PROVIDER=email

# Comma-separated work emails granted /admin access. NOTE: these do NOT bypass
# the ed-admin sign-in check — an admin email must ALSO be an active ed-admin
# staff member to sign in (in prod). Set by: developer.
# Match onboarding hub — comma-separated /admin emails (admin password sign-in).
HR_ADMIN_EMAILS=krupa@silverleaf.co.tz,hr@silverleaf.co.tz

# Per-admin bootstrap passwords (email:password pairs). Same as onboarding.
# ADMIN_PASSWORDS=admin@example.com:change-me
# ADMIN_PIN=

# Local/dev only — do not set on Vercel production.
# ADMIN_ALLOW_LOCAL_DIRECTORY_FALLBACK=1

# Bearer token for the ed-admin staff directory. REQUIRED in prod to verify
# staff sign-in (work email + Staff ID). When UNSET, sign-in falls back to the
# seeded staff table and accepts any non-empty Staff ID — outside production
# always; in production only with ALLOW_DEMO_AUTH=1 (otherwise sign-in
# fails closed). Set by: developer.
ED_ADMIN_API_TOKEN=

# Explicit opt-in for the seeded-staff demo sign-in fallback IN PRODUCTION
# (demo/showcase deploys only — it skips Staff ID verification). ONLY 1/true
# enable it; any other value (including 0/false) leaves it disabled. Outside
# production the fallback is always available. Set by: developer.
# ALLOW_DEMO_AUTH=

# Optional override for the ed-admin staff endpoint. Absent → code default
# (https://silverleafacademy.ed-space.net/api/general/v1/staff).
# ED_ADMIN_STAFF_API_URL=

# ===========================================================================
# AI  (AI Studio lesson-plan generation — optional)
# ===========================================================================

# OpenRouter API key for AI lesson-plan generation. Absent/empty → AI Studio
# is disabled and degrades gracefully. Set by: developer.
# OPENROUTER_API_KEY=

# OpenRouter model slug used for generation. Absent → code default
# (deepseek/deepseek-v4-pro, see src/lib/ai/model.ts). Must be a
# tool/structured-output capable OpenRouter model. Set by: developer.
# AI_MODEL_ID=deepseek/deepseek-v4-pro

# OpenRouter model slug used for vision/OCR extraction (textbook ingest).
# Absent → code default (google/gemini-3.5-flash). Set by: developer.
# AI_OCR_MODEL_ID=google/gemini-3.5-flash

# ===========================================================================
# STORAGE  (Vercel Blob — file uploads/exports)
# ===========================================================================

# Read/write token for Vercel Blob storage.
# Auto-injected by Vercel after adding Blob from the dashboard/marketplace —
# do NOT set manually in preview/prod. Local dev: leave empty unless testing
# Blob uploads. Set by: Vercel-injected.
BLOB_READ_WRITE_TOKEN=

# ---------------------------------------------------------------------------
# NOTES ON INTENTIONALLY OMITTED VARS
# ---------------------------------------------------------------------------
# NODE_ENV      — Next.js sets this automatically; do not override in prod.
# PORT          — Vercel manages the port; not configurable.
# PGLITE_MEMORY — test-harness only (in-memory PGlite for vitest/db scripts).
# next-intl     — No secrets required; locale config lives in source files.
# ---------------------------------------------------------------------------
