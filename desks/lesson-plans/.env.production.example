# ---------------------------------------------------------------------------
# .env.production.example — reference for production environment variables
# ---------------------------------------------------------------------------
# On Vercel, production environment variables are managed in the Vercel
# dashboard (Project → Settings → Environment Variables) or via the CLI:
#
#   vercel env add SESSION_SECRET production
#
# You do NOT deploy a .env.production file to Vercel. This file exists only
# as a reference so developers know which variables are expected in production.
#
# For local testing against a production-like config, run:
#   vercel env pull .env.local    (requires `vercel link` first)
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# DATABASE — auto-injected by Vercel Postgres (Neon)
# ---------------------------------------------------------------------------
# After adding Vercel Postgres from the dashboard/marketplace, Vercel
# automatically injects DATABASE_URL (and POSTGRES_* variants) into all
# three environments (development, preview, production).
# You do not need to set this manually.
DATABASE_URL=

# Optional: enable Postgres trigram fuzzy search once the pg_trgm extension
# is available on the database. Only "1"/"true" enable it.
# SEARCH_TRIGRAM=1

# ---------------------------------------------------------------------------
# SESSION — set manually in Vercel dashboard. REQUIRED in production.
# ---------------------------------------------------------------------------
# Signs the auth cookie. Generate a fresh one per environment:
# `openssl rand -hex 32`. Rotating it invalidates all existing sessions
# (forces re-login).
SESSION_SECRET=

# ---------------------------------------------------------------------------
# ADMIN ACCESS — set manually in Vercel dashboard
# ---------------------------------------------------------------------------

# Comma-separated work emails granted /admin access. These do NOT bypass the
# ed-admin sign-in check — an admin email must also be an active ed-admin staff
# member to sign in.
HR_ADMIN_EMAILS=hr@silverleaf.co.tz

# PIN for the admin self-elevation backend (`verifyAdminPin`). Currently
# UNREACHABLE: no UI collects a PIN — HR_ADMIN_EMAILS alone grants /admin at
# sign-in. Kept for a future elevation flow; optional. If you do set it, use
# a strong value.
# ADMIN_PIN=

# ---------------------------------------------------------------------------
# ED-ADMIN STAFF DIRECTORY — set manually in Vercel dashboard
# ---------------------------------------------------------------------------
# Bearer token for the ed-admin staff directory; required to verify staff
# sign-in (work email + Staff ID). Without it, production sign-in FAILS CLOSED
# unless ALLOW_DEMO_AUTH=1 is set. Optional ED_ADMIN_STAFF_API_URL overrides
# the default endpoint baked into the code.
ED_ADMIN_API_TOKEN=
# ED_ADMIN_STAFF_API_URL=

# Explicit opt-in for the seeded-staff demo sign-in fallback IN PRODUCTION
# (demo/showcase deploys only — it skips Staff ID verification). ONLY 1/true
# enable it; any other value (including 0/false) leaves it disabled.
# ALLOW_DEMO_AUTH=

# ---------------------------------------------------------------------------
# AI — set manually in Vercel dashboard (required for AI Studio)
# ---------------------------------------------------------------------------
# OpenRouter API key; enables lesson-plan generation and textbook OCR.
# Absent → AI Studio is disabled (rest of the app works normally).
OPENROUTER_API_KEY=

# Optional model overrides (OpenRouter slugs; defaults in src/lib/ai/model.ts):
# AI_MODEL_ID=deepseek/deepseek-v4-pro
# AI_OCR_MODEL_ID=google/gemini-3.5-flash

# ---------------------------------------------------------------------------
# VERCEL BLOB — auto-injected after provisioning
# ---------------------------------------------------------------------------
# After adding Vercel Blob from the dashboard/marketplace, Vercel
# automatically injects BLOB_READ_WRITE_TOKEN into the project.
BLOB_READ_WRITE_TOKEN=
