# ============================================================
# SILVERLEAF ACADEMY — Environment Variables
# Copy to .env and fill in your values
# NEVER commit .env to version control
# ============================================================

# ── DATABASE ─────────────────────────────────────────────────
# Format: postgresql://user:password@host:5432/database_name
DATABASE_URL=postgresql://silverleaf:yourpassword@localhost:5432/silverleaf_v3

# ── SERVER ────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# Frontend origin (for CORS and Socket.IO)
FRONTEND_URL=http://localhost:3000

# ── JWT AUTH ──────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_string_min_64_chars
JWT_EXPIRES=12h

# ── DEFAULT PASSWORD (new accounts + admin resets) ────────────
# Pick your own value — never reuse this placeholder in a real deployment.
DEFAULT_PASSWORD=ChangeThisDefault@2026

# ── EMAIL (Nodemailer) ────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@silverleaf.co.tz
SMTP_PASS=your_app_password_here

# ── WEBHOOKS ──────────────────────────────────────────────────
WEBHOOK_SECRET=replace-with-a-random-webhook-secret
CRON_SECRET=replace-with-a-random-string

# ── SMS / WHATSAPP (Africa's Talking) ─────────────────────────
AT_API_KEY=your_africastalking_api_key
AT_USERNAME=silverleaf
AT_SENDER_ID=Silverleaf
AT_WA_NUMBER=

# ── FILE UPLOADS ──────────────────────────────────────────────
# Absolute path to uploads directory
UPLOAD_DIR=./uploads

# Public API base URL (used to generate file URLs)
API_URL=http://localhost:5000

# ── FRONTEND (Vite) ───────────────────────────────────────────
# These go in frontend/.env (prefix with VITE_)
VITE_API_URL=http://localhost:5000/api
VITE_WS_URL=http://localhost:5000
