    "core_rules": [
      {
        "name": "occupancy_pct",
        "formula": "actual_students / max_capacity",
        "sheet": "Enrollment 26"
      },
      {
        "name": "remaining_seats",
        "formula": "max_capacity - actual_students",
        "sheet": "Enrollment 26"
      },
      {
        "name": "available_seats",
        "formula": "target_enrollment - retained_students",
        "sheet": "Leads Tracker 26"
      },
      {
        "name": "live_enrollment",
        "formula": "retained + new_enrolled - dropouts",
        "sheet": "Leads Tracker 26"
      },
      {
        "name": "campus_conversion",
        "formula": "admission_paid / total_leads",
        "sheet": "Leads Tracker 26"
      },
      {
        "name": "monthly_conversion",
        "formula": "enrolled_that_month / leads_that_month",
        "sheet": "Weekly Snapshot"
      },
      {
        "name": "kpi_progress",
        "formula": "actual / target",
        "sheet": "2. Top Sheet / 2026 Top sheet"
      },
      {
        "name": "week_variance",
        "formula": "current_week - previous_week",
        "sheet": "2026 Weekly Snapshot."
      },
      {
        "name": "company_enrollment",
        "formula": "Enrollment 26!D77 + K55 + R55",
        "sheet": "2. Top Sheet"
      },
      {
        "name": "social_following_actual",
        "formula": "instagram + facebook + linkedin",
        "sheet": "SM Following 26"
      },
      {
        "name": "social_following_vs_target",
        "formula": "actual_total / target_total",
        "sheet": "SM Following 26"
      },
      {
        "name": "social_output_month",
        "formula": "SUM(posts + stories) across platforms",
        "sheet": "SM Output 26"
      },
      {
        "name": "budget_line",
        "formula": "SUM(monthly_qty) * unit_cost; remaining = budget - spent",
        "sheet": "2026 budget"
      },
      {
        "name": "staff_referral_pay",
        "formula": "COUNTA(students) * 25000",
        "sheet": "2026 Staff Referals"
      },
      {
        "name": "sales_rep_pay",
        "formula": "COUNTA(students) * 25000; tax = 5%; net = gross - tax",
        "sheet": "Sales Rep Commission"
      },
      {
        "name": "feeder_daycare_pay",
        "formula": "agreed_amount * referral_count",
        "sheet": "Feeder Daycare Commissions"
      },
      {
        "name": "parent_referral_count",
        "formula": "COUNTA(students referred)",
        "sheet": "Parents Commission"
      }
    ]
