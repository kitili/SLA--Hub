# ============================================================
# SILVERLEAF ACADEMY — Environment Variables
# Copy to .env and fill in your values
# NEVER commit .env to version control
# ============================================================

# ── DATABASE (Supabase Postgres) ───────────────────────────────
# Use Supabase's transaction-mode POOLER connection string (port 6543), not the
# direct connection — serverless functions open many short-lived connections, and
# the pooler is what keeps that from exhausting Postgres's connection limit.
# Find it in: Supabase dashboard → Project Settings → Database → Connection pooling.
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:your-db-password@aws-0-region.pooler.supabase.com:6543/postgres

# ── SERVER ────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# Frontend origin (for CORS)
FRONTEND_URL=http://silverleaf.localhost:3180
# Extra browser origins that may post inquiries or read the public calendar (Wix site)
PUBLIC_WEB_ORIGINS=https://silverleaf.co.tz,https://www.silverleaf.co.tz

# ── JWT AUTH ──────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace-with-a-64+-character-random-string
JWT_EXPIRES=12h
# HMAC for httpOnly session cookies (same pattern as Onboarding Hub).
# Falls back to JWT_SECRET if unset.
# SESSION_SECRET=replace-with-a-64+-character-random-string

# ── DEFAULT PASSWORD (new accounts + admin resets) ────────────
# Pick your own value — never reuse this placeholder in a real deployment.
DEFAULT_PASSWORD=ChangeThisDefault@2026

# ── SUPABASE (Realtime + Storage) ─────────────────────────────
# Project Settings → API. SERVICE_ROLE_KEY is secret — server-side only, never
# send it to the frontend (the frontend uses its own anon key, see frontend/.env).
SUPABASE_URL=https://bchmzcrsimrrfxmnclik.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── CRON (Vercel Cron Jobs) ────────────────────────────────────
# Any random string — Vercel sends it back as a Bearer token on scheduled calls to
# /api/cron/*, so those routes can reject requests that aren't the real cron trigger.
# REQUIRED in production — cron endpoints fail closed when this is unset.
CRON_SECRET=replace-with-a-random-string

# ── BUFFER.COM (Silverleaf social publisher) ───────────────────
# Personal API key from Buffer → Account → API settings
# (https://developers.buffer.com). Not a Buffer consumer/OAuth app key.
BUFFER_API_KEY=
# Optional if the key can see more than one organization.
# BUFFER_ORGANIZATION_ID=

# ── WEBHOOKS (Ed Admin + optional Buffer inbound) ──────────────
# Shared fallback secret, or set service-specific secrets.
# Callers must send: Authorization: Bearer <secret>  OR  X-Webhook-Secret: <secret>
WEBHOOK_SECRET=replace-with-a-random-webhook-secret
# BUFFER_WEBHOOK_SECRET=optional-inbound-buffer-webhook-secret
# PUFFER_WEBHOOK_SECRET=legacy alias for BUFFER_WEBHOOK_SECRET
# EDADMIN_WEBHOOK_SECRET=optional-edadmin-specific-secret

# ── ED ADMIN SIS (GET-only Parents + Students) ────────────────
# Synced into edadmin_parents / edadmin_students, related by parent_id.
# https://silverleafacademy.ed-space.net/api/general/v1/Parents
# https://silverleafacademy.ed-space.net/api/general/v1/Students
EDADMIN_API_BASE=https://silverleafacademy.ed-space.net
EDADMIN_API_KEY=

# ── EMAIL (Nodemailer) ────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-smtp-user@example.com
SMTP_PASS=your-smtp-app-password

# ── SMS / WHATSAPP (Africa's Talking) ─────────────────────────
AT_API_KEY=your-africas-talking-api-key
AT_USERNAME=sandbox
AT_SENDER_ID=Silverleaf
# WhatsApp Business number registered with Africa's Talking (E.164).
# If unset, WhatsApp sends fall back to SMS when a fallback phone is provided.
AT_WA_NUMBER=

# ── FRONTEND (Vite) ───────────────────────────────────────────
# These go in frontend/.env (prefix with VITE_)
VITE_API_URL=http://localhost:5000/api
VITE_SUPABASE_URL=https://bchmzcrsimrrfxmnclik.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
