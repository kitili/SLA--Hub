# Signed session cookies. Required in production.
SESSION_SECRET=change-me-in-production

# Work-email domain for hub sign-in (comma-separated if more than one).
ALLOWED_EMAIL_DOMAINS=silverleaf.co.tz,silverleaf.ac.tz

# HR admins for the hub. Super admins also count as HR admin.
HR_ADMIN_EMAILS=krupa@silverleaf.co.tz,nelly@silverleaf.co.tz

# Workplace super admins. Sees the Progress dashboard for every department.
SUPER_ADMIN_EMAILS=krupa@silverleaf.co.tz,nelly@silverleaf.co.tz

# Ed Admin staff directory. Required for hub sign-in (work email + Staff ID).
# ED_ADMIN_API_TOKEN=
# ED_ADMIN_STAFF_API_URL=https://silverleafacademy.ed-space.net/api/general/v1/staff

# Bearer token for /api/v1 (ShuleOne). Generate a long random string. Never commit it.
# HUB_API_KEY=
# Optional if ShuleOne calls from a browser instead of a server.
# HUB_API_CORS_ORIGIN=https://shuleone.example.com

# Optional SMTP. If unset, local/dev prints the OTP in the terminal and on the sign-in screen.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=

# Documented live department sites. The hub ignores these for hosted desks so a
# laptop .env.local cannot send Onboarding, Ops, or the others to localhost.
WORKPLACE_ONBOARDING_URL=https://onboarding.silverleaf.co.tz
WORKPLACE_OPS_URL=https://ops-transport-system.vercel.app
WORKPLACE_UNIFORMS_URL=https://school-uniforms-lyart.vercel.app
WORKPLACE_MARKETING_URL=https://sla-marketing-web.vercel.app
WORKPLACE_DATA_TECH_URL=https://dataandtech.silverleaf.co.tz
WORKPLACE_TALENT_ACADEMY_URL=https://talent-academy-sla.vercel.app
WORKPLACE_VISITORS_URL=https://v-isitors.vercel.app
WORKPLACE_WORKBOARD_TASKS_URL=https://silverleaf-tasks.vercel.app
WORKPLACE_LESSON_PLANS_URL=https://silverleaf-lesson-plans-main.vercel.app
WORKPLACE_MEL_DASHBOARD_URL=https://silverleafmeldashboard-production.up.railway.app/#overview

# Ops Supabase (department schemas live here). Do not point this at public
# without DATABASE_SEARCH_PATH or hub migrations would hit Ops tables.
# DATABASE_URL=
# DATABASE_SEARCH_PATH=onboarding
# WORKPLACE_DATABASE_URL=
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
WORKPLACE_ONBOARDING_LOCAL_URL=http://localhost:3000
WORKPLACE_OPS_LOCAL_URL=http://localhost:3020
WORKPLACE_UNIFORMS_LOCAL_URL=http://localhost:3010
WORKPLACE_MARKETING_LOCAL_URL=http://localhost:3180
WORKPLACE_DATA_TECH_LOCAL_URL=http://localhost:4050
WORKPLACE_TALENT_ACADEMY_LOCAL_URL=http://localhost:8765
WORKPLACE_VISITORS_LOCAL_URL=http://localhost:3108
WORKPLACE_WORKBOARD_TASKS_LOCAL_URL=http://localhost:3200
WORKPLACE_LESSON_PLANS_LOCAL_URL=http://localhost:3300
WORKPLACE_MEL_DASHBOARD_LOCAL_URL=http://localhost:3400
